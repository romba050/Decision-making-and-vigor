bch_model_z_sm <- tidySEM::BCH(
x = final_lca_model_z,
model = "social_motivation ~ 1",
data = df_1_quests
)
sm_bch_z<- summary(bch_model_z_sm)   #M=mean; S=Variance
#NON Restricted model
bch_nrest_fit_z_sm <- OpenMx::mxRun(bch_model_z_sm)
#LRT 1-2
vin_sm_c1_c2_z <- OpenMx::mxConstraint(
class1.M[1,1] == class2.M[1,1],
name = "vin_sm_c1_c2_z"
)
bch_rest_c1_c2_sm <- OpenMx::mxModel(bch_model_z_sm, vin_sm_c1_c2_z)
bch_rest_fit_c1_c2_sm <- mxRun(bch_rest_c1_c2_sm)
LRT_c1_c2_sm <- mxCompare(bch_nrest_fit_z_sm, bch_rest_fit_c1_c2_sm)  #  NON SIGNIFICANT
#LRT 1-3
vincolo_c1_c3_z_sm <- OpenMx::mxConstraint(
class1.M[1,1] == class3.M[1,1],
name = "vin_sm_c1_c3_z"
)
bch_rest_c1_c3_sm <- OpenMx::mxModel(bch_model_z_sm, vincolo_c1_c3_z_sm)
bch_rest_fit_c1_c3_sm <- mxRun(bch_rest_c1_c3_sm)
LRT_c1_c3_sm <- mxCompare(bch_nrest_fit_z_sm, bch_rest_fit_c1_c3_sm) # SIGNIFICANT
#LRT  2-3
vincolo_c2_c3_z_sm <- OpenMx::mxConstraint(
class2.M[1,1] == class3.M[1,1],
name = "vin_sm_c2_c3_z"
)
bch_rest_c2_c3_sm <- OpenMx::mxModel(bch_model_z_sm, vincolo_c2_c3_z_sm)
bch_rest_fit_c2_c3_sm <- mxRun(bch_rest_c2_c3_sm)
LRT_c2_c3_sm <- mxCompare(bch_nrest_fit_z_sm, bch_rest_fit_c2_c3_sm)  # ALMOST SIGNIFICANT
